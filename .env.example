# Copy to .env.local and fill in values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers (required for editorial workflows and local expert testing)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Kevin Track — Private Author Studio (default on unless STUDIO_ENABLED=false)
STUDIO_ENABLED=true

# Phase 1A — Author Intent entry gate (development only; both required locally)
# When both are 1, Run Expert / Editorial Team route through Author Intent first.
STUDIO_AUTHOR_INTENT_ENABLED=0
STUDIO_EIC_ENABLED=0

# Phase 1B-a — Conversational manuscript brief intake (development only)
# Requires STUDIO_ENABLED, STUDIO_AUTHOR_INTENT_ENABLED=1, and STUDIO_EIC_ENABLED=1.
STUDIO_EIC_CONVERSATIONAL_INTAKE_ENABLED=0

# Phase 1B-ab — Conversational intelligence (EIC follow-ups + confirmation gate)
# Requires STUDIO_ENABLED, STUDIO_AUTHOR_INTENT_ENABLED=1, STUDIO_EIC_ENABLED=1,
# and STUDIO_EIC_CONVERSATIONAL_INTAKE_ENABLED=1. Unavailable in production.
STUDIO_CONVERSATIONAL_INTELLIGENCE_ENABLED=0

# Military Expert local Studio testing — default off; development only
STUDIO_MILITARY_EXPERT_ENABLED=0

# Publishing Workflow (Literary Agent) — default off
EDITORIAL_WORKFLOW_ENABLED=0

# Trigger.dev (local dev + Vercel)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# Optional local-only synchronous fallback — never use in production:
# EDITORIAL_WORKFLOW_DEV_SYNC_FALLBACK=1
