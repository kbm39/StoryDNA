# Copy to .env.local and fill in values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers (required for editorial workflows and local expert testing)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Kevin Track — Private Author Studio (default on unless STUDIO_ENABLED=false)
STUDIO_ENABLED=true

# Phase 1A — Author Intent entry gate (development only; both required locally)
# When both are 1, Run Expert / Editorial Team route through Author Intent first.
STUDIO_AUTHOR_INTENT_ENABLED=0
STUDIO_EIC_ENABLED=0

# Phase 1B-a — Conversational manuscript brief intake (development only)
# Requires STUDIO_ENABLED, STUDIO_AUTHOR_INTENT_ENABLED=1, and STUDIO_EIC_ENABLED=1.
STUDIO_EIC_CONVERSATIONAL_INTAKE_ENABLED=0

# Phase 1B-ab — Conversational intelligence (EIC follow-ups + confirmation gate)
# Requires STUDIO_ENABLED, STUDIO_AUTHOR_INTENT_ENABLED=1, STUDIO_EIC_ENABLED=1,
# and STUDIO_EIC_CONVERSATIONAL_INTAKE_ENABLED=1. Unavailable in production.
STUDIO_CONVERSATIONAL_INTELLIGENCE_ENABLED=0

# Amendment 002 — Progressive Editorial Understanding (development only)
# Requires STUDIO_ENABLED, STUDIO_AUTHOR_INTENT_ENABLED=1, STUDIO_EIC_ENABLED=1,
# STUDIO_EIC_CONVERSATIONAL_INTAKE_ENABLED=1, and STUDIO_CONVERSATIONAL_INTELLIGENCE_ENABLED=1.
# Unavailable in production. Default off.
STUDIO_PROGRESSIVE_EDITORIAL_UNDERSTANDING_ENABLED=0
# Subset flags (require master flag above):
STUDIO_PEU_ANTI_ECHO_ENABLED=0
STUDIO_PEU_PROVIDER_SYNTHESIS_ENABLED=0

# EP-1 — Editorial Profile runtime foundation (development only)
# Requires STUDIO_ENABLED, STUDIO_AUTHOR_INTENT_ENABLED=1, and STUDIO_EIC_ENABLED=1.
# Unavailable in production. Default off. Does not grant specialist manuscript access.
STUDIO_EDITORIAL_PROFILE_ENABLED=0
# EP-6 — Optional dev fixture for Studio Editorial Profile UI (development only)
# Values: active | awaiting_eic_confirmation | incomplete_evidence | generating | blocked | failed | validation_failed | none
# STUDIO_EDITORIAL_PROFILE_DEV_FIXTURE=active

# KDA-1 — Knowledge Domain Analysis runtime foundation (development only)
# Requires STUDIO_ENABLED, STUDIO_EIC_ENABLED=1, and STUDIO_AUTHOR_INTENT_ENABLED=1.
# Unavailable in production. Default off. Does not perform manuscript analysis in KDA-1.
STUDIO_KNOWLEDGE_DOMAIN_ANALYSIS_ENABLED=0
# Sub-flag: author-facing recommendation section rollout (requires master flag above)
STUDIO_KNOWLEDGE_DOMAIN_RECOMMENDATIONS_ENABLED=0

# Military Expert local Studio testing — default off; development only
STUDIO_MILITARY_EXPERT_ENABLED=0

# Publishing Workflow (Literary Agent) — default off
EDITORIAL_WORKFLOW_ENABLED=0

# Trigger.dev (local dev + Vercel)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# Optional local-only synchronous fallback — never use in production:
# EDITORIAL_WORKFLOW_DEV_SYNC_FALLBACK=1
